{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/runcycles/cycles-protocol/main/client-recovery/report.schema.json",
  "title": "Cycles SDK Recovery Conformance Evidence Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "generated_at",
    "profile",
    "claim",
    "implementation",
    "summary",
    "scenarios"
  ],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/runcycles/cycles-protocol/main/client-recovery/report.schema.json"
    },
    "schema_version": {
      "const": "1.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "commit",
        "catalog_sha256"
      ],
      "properties": {
        "name": {
          "const": "cycles-sdk-recovery"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "minLength": 1
        },
        "catalog_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "claim": {
      "enum": [
        "core",
        "durable"
      ]
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "commit"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence_url": {
      "type": "string",
      "format": "uri"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "passed",
        "failed"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "level",
          "name",
          "passed",
          "native_tests"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CR-(CORE|DURABLE|BOUNDARY)-[0-9]{3}$"
          },
          "level": {
            "enum": [
              "core",
              "durable",
              "boundary"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "passed": {
            "type": "boolean"
          },
          "native_tests": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "diagnostic": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
